def abs_distinct(A):
    # A is already sorted; use two pointers from both ends
    left = 0
    right = len(A) - 1
    count = 0

    while left <= right:
        left_abs = abs(A[left])
        right_abs = abs(A[right])

        count += 1  # found a new absolute value
        value = max(left_abs, right_abs)

        # Skip every element on both ends with this same absolute value
        while left <= right and abs(A[left]) == value:
            left += 1
        while left <= right and abs(A[right]) == value:
            right -= 1

    return count
